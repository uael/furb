{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "27c2b17b745836d2e3bcbb3db895117da92828f9",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore${scope}: Release${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "furb",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "cli/Cargo.toml",
          "jsonpath": "$.dependencies.furb.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"furb\" || @.name.value==\"furb-cli\")].version"
        },
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "pyproject.toml"
        },
        {
          "type": "generic",
          "path": "bind/python/pyproject.toml"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value==\"furb\")].version"
        },
        {
          "type": "json",
          "path": "bind/typescript/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bind/typescript/package.json",
          "jsonpath": "$.optionalDependencies.*"
        },
        {
          "type": "json",
          "path": "bind/typescript/npm/linux-x64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bind/typescript/npm/linux-arm64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bind/typescript/npm/darwin-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bind/typescript/npm/darwin-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bind/typescript/npm/win32-x64-msvc/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
