{
  "name": "@furb/engine",
  "version": "0.2.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "napi": {
    "binaryName": "furb"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./claude": {
      "types": "./dist/providers/claude.d.ts",
      "import": "./dist/providers/claude.js"
    }
  },
  "files": [
    "src",
    "dist",
    "index.cjs",
    "index.d.cts",
    "*.node",
    "system.json",
    "README.md"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0"
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  }
}
