.DS_Store
.idea/
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
dist/
.coverage
traces/
target
# The extension maturin builds into the binding: made by the build, never source.
*.so
*.pyd
*.node
# The loader of the engine, which napi writes at each build of the TypeScript package.
crates/typescript/index.cjs
# The program furb that a build of an earlier version copied beside the loader, which a clone may still hold.
crates/typescript/furb
crates/typescript/furb.exe
crates/typescript/furb.new
node_modules/
# Of .furb/, only the config and the extensions of the project are source.
.furb/*
!.furb/config.json
!.furb/skills/
# The config of a project on this machine alone, as its local models and its local extensions.
.furb/config.local.json
# The memory of a folder on this machine alone, which the memory extension reads after its AGENTS.md.
AGENTS.local.md
CLAUDE.local.md

# A frame of the window that differs from its capture, which insta writes beside it for a review.
*.snap.new
*.pending-snap
