{
  "name": "furb-workspace",
  "private": true,
  "workspaces": [
    "bind/typescript",
    "tui"
  ],
  "scripts": {
    "build": "bun run bind/typescript/build.ts",
    "tui": "bun run tui/src/cli.ts",
    "demo": "bun run tui/src/cli.ts --demo",
    "screenshots": "bun run tui/script/screenshots.ts",
    "check": "tsc --noEmit",
    "test": "bun test bind/typescript/test tui/test",
    "format": "biome format --write bind/typescript tui package.json tsconfig.json biome.json",
    "lint": "biome check bind/typescript tui package.json tsconfig.json biome.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@napi-rs/cli": "^3.10.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
