{
  "name": "furb-workspace",
  "private": true,
  "workspaces": [
    "bind/typescript",
    "docs/examples"
  ],
  "scripts": {
    "build": "bun run bind/typescript/build.ts",
    "check": "tsc --noEmit",
    "test": "bun run bind/typescript/script/test.ts",
    "protocol": "bun run bind/typescript/script/protocol.ts",
    "format": "biome format --write bind/typescript docs/examples package.json tsconfig.json biome.json",
    "lint": "biome check bind/typescript docs/examples package.json tsconfig.json biome.json --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@napi-rs/cli": "^3.10.5",
    "@types/bun": "latest",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "~5.9.3"
  }
}
